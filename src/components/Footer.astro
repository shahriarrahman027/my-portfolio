---
import type { Locale } from '@/types';
import { getTranslations } from '@/lib/i18n';
import { getProfile } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const profile = getProfile();
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide footer-inner">
    <div class="footer-top">
      <div class="footer-bio">
        <h3 class="footer-brand">{t.siteTitle}</h3>
        <p class="footer-summary">
          {locale === 'bn'
            ? 'প্রযুক্তি, কৃত্রিম বুদ্ধিমত্তা গবেষণা, কথাসাহিত্য ও ভিজ্যুয়াল স্টোরিটেলিংয়ের সন্ধিক্ষণে কাজ করছি।'
            : 'Exploring the intersection of artificial intelligence, computer science, literature, and visual storytelling.'}
        </p>
        <p class="footer-synitysoft">
          {profile.synitysoftRole[locale] || profile.synitysoftRole.en}
        </p>
      </div>

      <div class="footer-grid">
        <div class="footer-col">
          <h4 class="footer-heading">{locale === 'bn' ? 'অন্বেষণ' : 'Explore'}</h4>
          <ul class="footer-links">
            <li><a href={`/${locale}/about`}>{t.nav.about}</a></li>
            <li><a href={`/${locale}/technology`}>{t.nav.technology}</a></li>
            <li><a href={`/${locale}/now`}>{t.nav.now}</a></li>
            <li><a href={`/${locale}/resume`}>{t.nav.resume}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">{locale === 'bn' ? 'সৃজনশীল কাজ' : 'Creative'}</h4>
          <ul class="footer-links">
            <li><a href={`/${locale}/writing`}>{t.nav.writing}</a></li>
            <li><a href={`/${locale}/photography`}>{t.nav.photography}</a></li>
            <li><a href={`/${locale}/blog`}>{t.nav.blog}</a></li>
            <li><a href={`/${locale}/reading`}>{t.nav.reading}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">{locale === 'bn' ? 'সংযোগ' : 'Connect'}</h4>
          <ul class="footer-links">
            <li><a href={`/${locale}/contact`}>{t.nav.contact}</a></li>
            <li><a href={`https://github.com/${profile.githubUsername || 'shahriarrahman027'}`} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
            <li><a href={`mailto:${profile.email || 'mdshahriar.contact@gmail.com'}`}>Email ↗</a></li>
            <li><a href="/admin" class="admin-link">{t.nav.admin}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} {t.siteTitle}. {locale === 'bn' ? 'সর্বস্বত্ব সংরক্ষিত।' : 'All rights reserved.'}
      </p>

      <div class="footer-colophon">
        <span>{locale === 'bn' ? 'অ্যাস্ট্রো ও টাইপস্ক্রিপ্ট দ্বারা নির্মিত' : 'Built with Astro & TypeScript'}</span>
        <span>·</span>
        <span>{locale === 'bn' ? 'ভার্সেল সার্ভারলেস প্ল্যাটফর্ম' : 'Hosted on Vercel'}</span>
      </div>

      <button
        type="button"
        id="back-to-top"
        class="back-to-top-btn"
        aria-label={t.actions.backToTop}
      >
        ↑ {t.actions.backToTop}
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-light);
    margin-top: auto;
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  .footer-bio {
    max-width: 380px;
  }

  .footer-brand {
    font-size: var(--text-2xl);
    font-family: var(--font-serif);
    margin-bottom: var(--space-2);
  }

  .footer-summary {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-2);
  }

  .footer-synitysoft {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--accent-primary);
  }

  .footer-grid {
    display: flex;
    gap: var(--space-12);
  }

  .footer-col {
    min-width: 120px;
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-primary);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-light);
    font-size: var(--text-xs);
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-colophon {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
  }

  .back-to-top-btn {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .back-to-top-btn:hover {
    color: var(--accent-primary);
    background: var(--bg-subtle);
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
    }
    .footer-grid {
      flex-wrap: wrap;
      gap: var(--space-8);
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  setupBackToTop();
  document.addEventListener('astro:after-swap', setupBackToTop);
</script>

