---
import type { Locale } from '@/types';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
import { getReadingList } from '@/lib/content';
import { getTranslations } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const books = getReadingList(false);
---

<BaseLayout
  title={t.nav.reading}
  description={locale === 'bn' ? 'শাহরিয়ার রহমানের প্রিয় বই, পড়া ও ভাবনার তালিকা' : 'A curated reading list of books on computer science, AI, literature, philosophy, and cinema.'}
  locale={locale}
>
  <div class="container-narrow reading-page">
    <header class="page-header">
      <span class="eyebrow">{locale === 'bn' ? 'গ্রন্থপঞ্জি ও মনন' : 'Curated Library'}</span>
      <h1 class="page-title">{locale === 'bn' ? 'বইয়ের তালিকা ও পাঠপ্রতিক্রিয়া' : 'Reading List & Reflections'}</h1>
      <p class="editorial-lead">
        {locale === 'bn'
          ? 'কম্পিউটার বিজ্ঞান, কৃত্রিম বুদ্ধিমত্তা, বিশ্বসাহিত্য এবং দর্শনের যেসব বই আমাকে ভাবায় ও নতুন চিন্তার খোরাক জোগায়।'
          : 'Books that shape my thinking across computational theory, artificial intelligence, classic literature, and philosophy.'}
      </p>
    </header>

    {books.length === 0 ? (
      <EmptyState
        icon="book"
        title={locale === 'bn' ? 'এখনও কোনো বইয়ের তালিকা যোগ করা হয়নি' : 'No reading items published yet'}
        description={locale === 'bn' ? 'পঠিত ও অধ্যয়নাধীন বইসমূহের নাম এবং ব্যক্তিগত পাঠপ্রতিক্রিয়া এখানে যোগ করা হবে।' : 'Books and personal reflections will appear here as I curate my reading shelf.'}
      />
    ) : (
      <div class="books-list">
        {books.map((book) => (
          <article class="editorial-card book-item">
            <div class="book-header">
              <span class="tag">{t.readingStatus[book.status] || book.status}</span>
              <span class="book-category">{book.category}</span>
            </div>
            <h3 class="book-title">{book.title}</h3>
            <p class="book-author">{locale === 'bn' ? 'লেখক:' : 'By'} {book.author}</p>
            {book.notes && (
              <p class="book-notes">{book.notes[locale] || book.notes.en}</p>
            )}
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .reading-page {
    padding: var(--space-16) 0 var(--space-24);
  }

  .page-header {
    margin-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-light);
    padding-bottom: var(--space-8);
  }

  .page-title {
    font-size: var(--text-4xl);
    margin-top: var(--space-2);
  }

  .books-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .book-item {
    padding: var(--space-6);
  }

  .book-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .book-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .book-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-1);
  }

  .book-author {
    font-size: var(--text-sm);
    color: var(--accent-primary);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .book-notes {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
  }
</style>

