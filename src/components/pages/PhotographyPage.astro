---
import type { Locale } from '@/types';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
import { Lightbox } from '@/components/Lightbox';
import { getPhotographs } from '@/lib/content';
import { getTranslations } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const photos = getPhotographs(false);

const collections = Array.from(new Set(photos.map((p) => p.collection).filter(Boolean)));
---

<BaseLayout
  title={t.nav.photography}
  description={locale === 'bn' ? 'শাহরিয়ার রহমানের ভিজ্যুয়াল জার্নাল ও ফটোগ্রাফি সংগ্রহ' : 'A visual journal capturing moments, geometry, and human narratives through light and shadow.'}
  locale={locale}
>
  <div class="container-wide photography-page">
    <header class="page-header">
      <span class="eyebrow">{locale === 'bn' ? 'ভিজ্যুয়াল জার্নাল ও স্থিরচিত্র' : 'Visual Journal & Light'}</span>
      <h1 class="page-title">{locale === 'bn' ? 'ফটোগ্রাফি ও গল্পবলন' : 'Photography & Visual Journal'}</h1>
      <p class="editorial-lead">
        {locale === 'bn'
          ? 'আলোছায়া, জ্যামিতি এবং দৈনন্দিন জীবনের অব্যক্ত অনুভূতির গল্প—লেন্সের মাধ্যমে সংরক্ষিত।'
          : 'Documenting light, urban geometry, and candid human stillness through observational photography.'}
      </p>

      {collections.length > 0 && (
        <div class="collections-filter">
          <span class="filter-label">{locale === 'bn' ? 'সংগ্রহ:' : 'Collections:'}</span>
          <button type="button" class="filter-btn active" data-filter="all">
            {t.actions.filterAll}
          </button>
          {collections.map((col) => (
            <button type="button" class="filter-btn" data-filter={col}>
              {col}
            </button>
          ))}
        </div>
      )}
    </header>

    {photos.length === 0 ? (
      <EmptyState
        icon="camera"
        title={locale === 'bn' ? 'এখনও কোনো ছবি যোগ করা হয়নি' : 'No photographs published yet'}
        description={locale === 'bn' ? 'আমার নিজস্ব ক্যামেরা দিয়ে তোলা অরিজিনাল ছবিসমূহ ক্যাপশনসহ দ্রুত আপলোড করা হবে।' : 'Original photographs, captions, and camera metadata will be curated here through the visual journal.'}
      />
    ) : (
      <>
        <div class="gallery-grid">
          {photos.map((photo, index) => {
            const title = photo.title[locale] || photo.title.en;
            const caption = photo.caption[locale] || photo.caption.en;
            return (
              <figure class="gallery-item" data-collection={photo.collection} id={photo.id}>
                <div class="image-wrapper" onclick={`window.openLightbox && window.openLightbox(${index})`} role="button" tabindex="0" aria-label={`View photo: ${title}`}>
                  <img
                    src={photo.imageUrl}
                    alt={photo.altText || title}
                    loading="lazy"
                    class="gallery-img"
                  />
                  <div class="image-overlay">
                    <span class="zoom-indicator">⤢ {locale === 'bn' ? 'বড় করে দেখুন' : 'Expand'}</span>
                  </div>
                </div>
                <figcaption class="gallery-caption">
                  <h3 class="photo-title">{title}</h3>
                  {caption && <p class="photo-caption-text">{caption}</p>}
                  <div class="photo-meta">
                    {photo.location && <span class="photo-loc">📍 {photo.location}</span>}
                    {photo.camera && <span class="photo-cam">📷 {photo.camera}</span>}
                  </div>
                </figcaption>
              </figure>
            );
          })}
        </div>

        <Lightbox client:load photos={photos} locale={locale} />
      </>
    )}
  </div>
</BaseLayout>

<style>
  .photography-page {
    padding: var(--space-16) 0 var(--space-24);
  }

  .page-header {
    margin-bottom: var(--space-16);
    border-bottom: 1px solid var(--border-light);
    padding-bottom: var(--space-8);
  }

  .page-title {
    font-size: var(--text-4xl);
    margin-top: var(--space-2);
  }

  .collections-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover, .filter-btn.active {
    background: var(--accent-subtle);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-8);
  }

  .gallery-item {
    background: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-normal);
  }

  .gallery-item:hover {
    border-color: var(--border-medium);
    box-shadow: var(--shadow-md);
  }

  .image-wrapper {
    position: relative;
    cursor: pointer;
    aspect-ratio: 3/2;
    overflow: hidden;
    background: #0d0e10;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .image-wrapper:hover .gallery-img {
    transform: scale(1.02);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity var(--transition-fast);
  }

  .image-wrapper:hover .image-overlay,
  .image-wrapper:focus-visible .image-overlay {
    opacity: 1;
  }

  .zoom-indicator {
    color: white;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background: rgba(0, 0, 0, 0.6);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .gallery-caption {
    padding: var(--space-4) var(--space-6);
  }

  .photo-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .photo-caption-text {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .photo-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupPhotoFilter() {
    const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.gallery-item');

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        btns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter;

        items.forEach((item) => {
          if (filter === 'all' || item.dataset.collection === filter) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  }

  setupPhotoFilter();
  document.addEventListener('astro:after-swap', setupPhotoFilter);
</script>

