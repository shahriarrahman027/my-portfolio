---
import type { Locale } from '@/types';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ReadingProgress } from '@/components/ReadingProgress';
import { getBlogPostBySlug } from '@/lib/content';
import { getTranslations } from '@/lib/i18n';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = getTranslations(locale);
const post = getBlogPostBySlug(slug, false);

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<BaseLayout
  title={post.title}
  description={post.summary}
  locale={locale}
>
  <ReadingProgress client:load />

  <article class="container-narrow blog-detail-page">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={`/${locale}/blog`}>← {t.nav.blog}</a>
    </nav>

    <header class="blog-header">
      <div class="blog-meta">
        <span class="tag">{t.blogCategories[post.category] || post.category}</span>
        {post.readingTimeMinutes && (
          <span class="reading-time">
            {post.readingTimeMinutes} {t.labels.readingTime}
          </span>
        )}
      </div>

      <h1 class="blog-title">{post.title}</h1>
      <p class="blog-summary-lead">{post.summary}</p>

      <div class="blog-byline">
        <span>{t.siteTitle}</span>
        <span>·</span>
        <span>
          {new Date(post.createdAt).toLocaleDateString(locale === 'bn' ? 'bn-BD' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </span>
      </div>
    </header>

    <div class="prose reading-content" set:html={post.content.replace(/\n/g, '<br/>')} />

    <footer class="blog-detail-footer">
      {post.tags && post.tags.length > 0 && (
        <div class="tags-row">
          <span class="tags-label">{t.labels.tags}:</span>
          {post.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}

      <div class="back-nav">
        <a href={`/${locale}/blog`} class="btn">
          ← {locale === 'bn' ? 'ব্লগ তালিকায় ফিরুন' : 'Back to Blog'}
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-detail-page {
    padding: var(--space-12) 0 var(--space-24);
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-8);
  }

  .breadcrumb-nav a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--accent-primary);
  }

  .blog-header {
    border-bottom: 1px solid var(--border-light);
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .reading-time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .blog-title {
    font-size: clamp(2rem, 4vw + 1rem, 3.25rem);
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .blog-summary-lead {
    font-size: var(--text-xl);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-6);
  }

  .blog-byline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .reading-content {
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--text-primary);
  }

  .blog-detail-footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-light);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .tags-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
