---
import type { Locale } from '@/types';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ReadingProgress } from '@/components/ReadingProgress';
import { getWritingBySlug } from '@/lib/content';
import { getTranslations } from '@/lib/i18n';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = getTranslations(locale);
const writing = getWritingBySlug(slug, false);

if (!writing) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<BaseLayout
  title={writing.title}
  description={writing.summary}
  locale={locale}
>
  <ReadingProgress client:load />

  <article class="container-narrow writing-detail-page">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href={`/${locale}/writing`}>← {t.nav.writing}</a>
    </nav>

    <header class="writing-header">
      <div class="writing-meta">
        <span class="tag">{t.writingCategories[writing.category] || writing.category}</span>
        {writing.series && <span class="tag series-tag">Series: {writing.series}</span>}
        {writing.readingTimeMinutes && (
          <span class="reading-time">
            {writing.readingTimeMinutes} {t.labels.readingTime}
          </span>
        )}
      </div>

      <h1 class="writing-title">{writing.title}</h1>
      <p class="writing-summary-lead">{writing.summary}</p>

      <div class="writing-byline">
        <span>{t.siteTitle}</span>
        <span>·</span>
        <span>
          {new Date(writing.createdAt).toLocaleDateString(locale === 'bn' ? 'bn-BD' : 'en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </span>
      </div>
    </header>

    <div class="prose reading-content" set:html={writing.content.replace(/\n/g, '<br/>')} />

    <footer class="writing-detail-footer">
      {writing.tags && writing.tags.length > 0 && (
        <div class="tags-row">
          <span class="tags-label">{t.labels.tags}:</span>
          {writing.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}

      <div class="back-nav">
        <a href={`/${locale}/writing`} class="btn">
          ← {locale === 'bn' ? 'লেখালেখির তালিকায় ফিরুন' : 'Back to Writing Library'}
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .writing-detail-page {
    padding: var(--space-12) 0 var(--space-24);
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-8);
  }

  .breadcrumb-nav a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--accent-primary);
  }

  .writing-header {
    border-bottom: 1px solid var(--border-light);
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .writing-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .series-tag {
    background: var(--accent-subtle);
    color: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  .reading-time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .writing-title {
    font-size: clamp(2rem, 4vw + 1rem, 3.25rem);
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .writing-summary-lead {
    font-size: var(--text-xl);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: var(--space-6);
  }

  .writing-byline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .reading-content {
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--text-primary);
  }

  .writing-detail-footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-light);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .tags-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
