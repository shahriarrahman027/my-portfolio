# Administrative Security
# Set this to a strong secret in production. Used to authenticate admin dashboard sessions.
ADMIN_SECRET=replace_with_your_secure_admin_password_or_token

# Optional: Public GitHub Integration
# Set your public GitHub username to fetch repositories dynamically
GITHUB_USERNAME=shahriar-rahman

# Optional: Cloud Database (Supabase)
# If configured, transitions storage from local JSON to Supabase free tier
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Email Service for Contact Forwarding (e.g. Resend free tier)
RESEND_API_KEY=
